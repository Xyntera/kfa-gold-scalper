# Copy to `.env` (never committed) and fill in your own keys.
# chmod 600 .env

# TwelveData API key (free at twelvedata.com — 800 calls/day).
# 1-minute polling needs ~1,440 calls/day, so add 2+ keys for full-day coverage.
TWELVEDATA_KEY=
#TWELVEDATA_KEY_2=
#TWELVEDATA_KEY_3=

# Telegram alerts (optional but recommended — this is how signals reach your phone).
# 1. Message @BotFather on Telegram, /newbot, paste the token here.
# 2. Message @userinfobot, copy your numeric id here.
# 3. Send your new bot any message once (bots can't message you first).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
